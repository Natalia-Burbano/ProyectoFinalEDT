<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="pantalla" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.proyectofinal.gui.PanelPreparacion">
   <top>
      <VBox spacing="14.0">
         <children>
            <VBox spacing="2.0">
               <children>
                  <Label styleClass="titulo-pantalla" text="Preparacion de apartamentos" />
                  <Label styleClass="texto-suave" text="Primero los que tienen entrada hoy, por hora de llegada; despues los demas" />
               </children>
            </VBox>
            <HBox spacing="12.0">
               <children>
                  <VBox styleClass="resumen,resumen-pendiente">
                     <children>
                        <Label fx:id="etiquetaPendientes" styleClass="resumen-numero" text="0" />
                        <Label styleClass="resumen-texto" text="Esperando en la cola" />
                     </children>
                  </VBox>
                  <VBox styleClass="resumen,resumen-ocupado">
                     <children>
                        <Label fx:id="etiquetaEnPreparacion" styleClass="resumen-numero" text="0" />
                        <Label styleClass="resumen-texto" text="Preparandose ahora" />
                     </children>
                  </VBox>
                  <VBox styleClass="resumen,resumen-preparado">
                     <children>
                        <Label fx:id="etiquetaPromedio" styleClass="resumen-numero" text="0 min" />
                        <Label styleClass="resumen-texto" text="Tiempo promedio de preparacion" />
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
         <BorderPane.margin>
            <Insets bottom="16.0" />
         </BorderPane.margin>
      </VBox>
   </top>
   <center>
      <VBox spacing="10.0" styleClass="tarjeta-panel">
         <children>
            <HBox alignment="CENTER_LEFT">
               <children>
                  <Label styleClass="subtitulo" text="Cola de preparacion" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="botonIniciar" mnemonicParsing="false" onAction="#iniciarSiguiente" styleClass="boton-principal" text="Iniciar siguiente" />
               </children>
            </HBox>
            <ScrollPane fitToWidth="true" styleClass="scroll" VBox.vgrow="ALWAYS">
               <content>
                  <VBox fx:id="filasCola" spacing="4.0" />
               </content>
            </ScrollPane>
         </children>
      </VBox>
   </center>
   <right>
      <VBox prefWidth="330.0" spacing="16.0">
         <children>
            <VBox spacing="10.0" styleClass="tarjeta-panel">
               <children>
                  <Label styleClass="subtitulo" text="Preparandose ahora" />
                  <VBox fx:id="filasEnPreparacion" spacing="6.0" />
               </children>
            </VBox>
            <VBox spacing="10.0" styleClass="tarjeta-panel">
               <children>
                  <Label styleClass="subtitulo" text="Ruta sugerida" />
                  <Label styleClass="texto-suave" text="Sale de recepcion y pasa por los pendientes en el orden de la cola" wrapText="true" />
                  <Label fx:id="etiquetaRuta" styleClass="etiqueta-ruta" wrapText="true" />
                  <Button mnemonicParsing="false" onAction="#verEnMapa" styleClass="boton-secundario" text="Ver en el mapa" />
               </children>
            </VBox>
         </children>
         <BorderPane.margin>
            <Insets left="16.0" />
         </BorderPane.margin>
      </VBox>
   </right>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.proyectofinal.gui.PanelCalendario">
    <top>
        <VBox spacing="8">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="&lt;" onAction="#mesAnterior"/>
                <Label fx:id="lblMes" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
                <Button text="&gt;" onAction="#mesSiguiente"/>
                <Button text="Hoy" onAction="#irAHoy"/>
            </HBox>
            <HBox spacing="14" alignment="CENTER_LEFT">
                <Label text="Ocupada" style="-fx-background-color: #4a90d9; -fx-text-fill: white; -fx-padding: 2 8 2 8;"/>
                <Label text="Bloqueada (fuera de servicio)" style="-fx-background-color: #9e9e9e; -fx-text-fill: white; -fx-padding: 2 8 2 8;"/>
                <Label text="Libre" style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-padding: 2 8 2 8;"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <ScrollPane>
            <content>
                <GridPane fx:id="grilla" hgap="1" vgap="1">
                    <padding><Insets top="6" right="6" bottom="6" left="6"/></padding>
                </GridPane>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
